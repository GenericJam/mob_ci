#!/bin/sh
# First on PATH only inside an iOS cell, once ci_keychain.sh has unlocked the
# CI keychain: sign from it, never from the login keychain an ssh session
# cannot use. `--keychain` only narrows where the signing identity is looked
# up, so verify and display calls pass through unchanged.
exec "${MOB_CI_REAL_CODESIGN:-/usr/bin/codesign}" --keychain "${MOB_CI_CODESIGN_KEYCHAIN:?}" "$@"
