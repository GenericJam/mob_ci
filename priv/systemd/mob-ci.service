[Unit]
Description=mob_ci scheduled device sweep (device CI for the mob ecosystem)
Documentation=file:%h/code/mob_ci/decisions/2026-06-23-trigger-adapters.md
# The farm needs Docker; don't fire before it's up.
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/code/mob_ci
# Property sweep over 4 sampled plugin subsets on the shared redroid farm. The
# sweep cooperates with sloppy_joe staging via the farm's flock admit ceiling, so
# it yields when staging is busy; the timer points it at a low-traffic window.
ExecStart=%h/code/mob_ci/priv/ci-run.sh sweep 4
# Each activation switch is a fresh build (minutes); give the whole sweep room.
TimeoutStartSec=3600
# Be a polite neighbour to the live staging pool sharing this box.
Nice=10
IOSchedulingClass=idle
